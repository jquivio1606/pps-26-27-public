# ---------------------------------------------------------------------------
#  Cinema API - variables de entorno
#  Copia este fichero como .env y ajusta los valores.
#  En Render no hace falta el fichero: se definen en el dashboard.
# ---------------------------------------------------------------------------

# Base de datos.
# En Render: Dashboard -> tu PostgreSQL -> Connections -> Internal Database URL
# Ejemplo: postgresql://cinema_user:clave@dpg-xxxxx-a/cinema_db
# Si no se define, se usa SQLite en backend/cinema.db (solo desarrollo local).
# DATABASE_URL=postgresql://usuario:clave@host:5432/base_de_datos

# Clave de firma de los JWT. Genera una aleatoria con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-en-produccion

# Minutos de validez del token de acceso.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# GitHub OAuth (opcional).
# En Render, si no se define GITHUB_REDIRECT_URI, se usa RENDER_EXTERNAL_URL
# (la URL pública del servicio) + /auth/github/callback.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=https://tu-servicio.onrender.com/auth/github/callback

# URL pública del frontend si está desplegado en un origen distinto del backend
# (por ejemplo, otro servicio de Render o Vercel). Se usa para volver a la web
# con el token tras el login con GitHub. Si no se define: mismo origen.
# FRONTEND_URL=https://tu-frontend.onrender.com
